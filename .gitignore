.claude/
.venv/
__pycache__/
*.pyc
*.pyo
.env
.env.*
# the secret-free template is meant to be committed
!.env.example
*.egg-info/
dist/
build/
.DS_Store
Thumbs.db
.ipynb_checkpoints/
.coverage

# Raw per-run prediction dumps from src/stability.py — intermediate, not the
# deliverable. The summary (evals/stability.txt) is what gets committed.
evals/runs/

# Live prompt-optimization run logs (src/optimize.py writes one per run). The
# tracked sample_dryrun_run.jsonl is the committed reference; real runs are
# transient local artifacts, not deliverables.
evals/optimize/run_*.jsonl

graphify-out/

# Fitted bake-off artifacts: binary, reproducible offline from committed data
evals/baseline_model.joblib

# Rung-2 ML-loop run logs (src/ml_loop.py writes one per run), same policy
# as the rung-1 optimize logs above.
evals/ml_loop/run_*.jsonl

# L4 pipeline audit trails (src/l4_pipeline.py, one per run), same policy
# as the loop run logs above.
evals/l4/audit_*.jsonl
